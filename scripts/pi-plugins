#!/usr/bin/env python3
"""Keep a shared Git checkout of a plugin collection and enable packages per Pi project."""

import argparse
import hashlib
import itertools
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
from pathlib import Path


PLUGIN_NAME = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*")
SCP_SOURCE = re.compile(r"(?:[\w.-]+@)?[\w.-]+:[^:\s][^\s]*")
PI_MANAGEMENT = {"install", "remove", "uninstall", "update", "list", "config", "auth", "mcp", "-h", "--help", "-v", "--version"}
SHELL_MARKER = "# >>> ai-plugin-manager: local Pi >>>"


def xdg_home(variable, fallback):
    home = Path(os.environ.get(variable, ""))
    return home if home.is_absolute() else Path.home() / fallback


def checkout_path(source):
    data_home = xdg_home("XDG_DATA_HOME", ".local/share")
    key = hashlib.sha256(source.encode()).hexdigest()
    folder = data_home / "pi-plugins" / "git"
    legacy = folder / key
    # Existing `pi install -l` entries refer to the old paths; don't move them.
    if has_checkout(legacy):
        return legacy
    return folder / f"{inferred_alias(source)[:64]}--{key}"


def sources_dir():
    return xdg_home("XDG_CONFIG_HOME", ".config") / "pi-plugins" / "sources"


def sources():
    return {p.name: p.read_text(encoding="utf-8").strip() for p in sorted(sources_dir().glob("*"))
            if PLUGIN_NAME.fullmatch(p.name) and p.is_file()}


def valid_source(source):
    return (not source.startswith("-") and not any(ord(c) < 32 for c in source)
            and (re.fullmatch(r"(?:https|ssh)://[^\s]+", source) or SCP_SOURCE.fullmatch(source)
                 or Path(source).is_absolute()))


def normalize_source(source):
    if source.startswith(("git:https://", "git:ssh://")):
        return source[4:]
    if re.match(r"git:[\w.-]+\.[\w.-]+/", source):
        return "https://" + source[4:]
    return source


def inferred_alias(source):
    name = re.split(r"[/:]", source.rstrip("/"))[-1]
    name = re.sub(r"\.git$", "", name, flags=re.IGNORECASE)
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-") or "source"


def has_checkout(checkout):
    return not checkout.is_symlink() and (checkout / ".git").is_dir()


def run(*args):
    subprocess.run(args, check=True)


def ensure_checkout(source, checkout):
    if not has_checkout(checkout):
        checkout.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(prefix=".clone-", dir=checkout.parent) as tmp:
            staging = Path(tmp) / "checkout"
            run("git", "clone", "--", source, str(staging))
            try:
                staging.rename(checkout)
            except OSError:
                if not has_checkout(checkout):
                    raise


def pi_metadata(plugin):
    manifest = plugin / "package.json"
    if plugin.is_symlink() or manifest.is_symlink() or not manifest.is_file():
        raise ValueError(f"В этой поставке нет Pi-пакета {plugin.name!r}.")
    metadata = json.loads(manifest.read_text(encoding="utf-8"))
    if not isinstance(metadata, dict) or not isinstance(metadata.get("pi"), dict):
        raise ValueError("У пакета нет манифеста Pi.")
    return metadata


def plugin_path(checkout, name):
    plugin = checkout / name
    pi_metadata(plugin)
    return plugin


def catalog(source, checkout):
    ensure_checkout(source, checkout)
    plugins = []
    for path in sorted(checkout.iterdir()):
        # The manager is a global bootstrap package, not a project plugin.
        if path.name != "plugin-manager" and PLUGIN_NAME.fullmatch(path.name):
            try:
                plugin_path(checkout, path.name)
            except ValueError:
                continue
            plugins.append(path.name)
    result = {"checkout": str(checkout), "plugins": plugins}
    if not plugins:
        try:
            name = pi_metadata(checkout).get("name")
        except ValueError:
            pass
        else:
            result["rootPlugin"] = name if isinstance(name, str) and name.strip() else "корневой пакет"
    return result


def add_source(alias, source, checkout):
    registered = sources()
    if alias and alias in registered and registered[alias] != source:
        raise ValueError(f"Имя источника {alias!r} уже занято.")
    if not alias:
        existing = next((name for name, address in registered.items() if address == source), None)
        if existing:
            return existing
    available = catalog(source, checkout)
    if not available["plugins"] and not available.get("rootPlugin"):
        raise ValueError("В источнике не найдены Pi-пакеты. Нужен package.json с секцией pi в корне или в каталогах плагинов.")
    folder = sources_dir()
    folder.mkdir(parents=True, exist_ok=True)
    base = alias or inferred_alias(source)
    with tempfile.TemporaryDirectory(prefix=".source-", dir=folder) as tmp:
        staged = Path(tmp) / "address"
        staged.write_text(source + "\n", encoding="utf-8")
        for index in itertools.count(1):
            name = base if index == 1 else f"{base}-{index}"
            target = folder / name
            try:
                os.link(staged, target)
            except FileExistsError:
                if target.read_text(encoding="utf-8").strip() != source:
                    if alias:
                        raise ValueError(f"Имя источника {alias!r} уже занято.") from None
                    continue
            return name


def project_selections_dir():
    cwd = Path.cwd()
    git = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=cwd, capture_output=True, text=True)
    root = Path(git.stdout.strip()).resolve() if git.returncode == 0 else cwd
    key = hashlib.sha256(os.fsencode(root)).hexdigest()
    return sources_dir().parent / "projects" / key


def personal_choices():
    choices = {}
    for path in sorted(project_selections_dir().glob("*.json")):
        if path.is_symlink() or not path.is_file():
            continue
        entry = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(entry, dict):
            continue
        source, name = entry.get("source"), entry.get("plugin")
        if isinstance(source, str) and valid_source(source) and isinstance(name, str) and valid_plugin(name):
            choices.setdefault(source, []).append(name)
    return choices


def valid_plugin(name):
    return name == "." or PLUGIN_NAME.fullmatch(name) is not None


def save_personal_choice(source, name, enabled):
    folder = project_selections_dir()
    identity = json.dumps({"source": source, "plugin": name}, ensure_ascii=False)
    key = hashlib.sha256(identity.encode()).hexdigest()
    target = folder / f"{key}.json"
    if not enabled:
        target.unlink(missing_ok=True)
        return
    checkout = checkout_path(source)
    ensure_checkout(source, checkout)
    plugin_path(checkout, name)
    folder.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=".selection-", dir=folder) as tmp:
        staged = Path(tmp) / "selection.json"
        staged.write_text(identity + "\n", encoding="utf-8")
        staged.replace(target)


def link_launcher(target):
    script = Path(__file__).resolve()
    target.parent.mkdir(parents=True, exist_ok=True)
    try:
        target.symlink_to(script)
    except FileExistsError:
        if not target.is_symlink() or target.resolve() != script:
            raise ValueError(f"{target} уже существует; не перезаписываю") from None
    return target


def install_launcher():
    return link_launcher(Path.home() / ".local" / "bin" / "pi-with-plugins")


def shell_rc():
    shell = Path(os.environ.get("SHELL", "")).name
    if shell == "zsh":
        return Path(os.environ.get("ZDOTDIR") or Path.home()) / ".zshrc"
    if shell == "bash":
        return Path.home() / ".bashrc"
    return None


def launcher_status():
    rc = shell_rc()
    if rc is None:
        return "unsupported"
    target = sources_dir().parent / "bin" / "pi"
    if target.is_symlink() and target.resolve() == Path(__file__).resolve() and rc.is_file():
        if SHELL_MARKER in rc.read_text(encoding="utf-8").splitlines():
            return "configured"
    return "needs-setup"


def setup_pi():
    rc = shell_rc()
    if rc is None:
        raise ValueError("автонастройка поддерживает bash и zsh; для других оболочек используйте /plugin launcher")
    current = rc.read_text(encoding="utf-8") if rc.exists() else ""
    folder = sources_dir().parent / "bin"
    link_launcher(folder / "pi")
    if SHELL_MARKER not in current.splitlines():
        quoted = shlex.quote(str(folder))
        block = (f"\n{SHELL_MARKER}\n"
                 f"case \"$PATH\" in {quoted}:*) ;; *) export PATH={quoted}:\"$PATH\" ;; esac\n"
                 "# <<< ai-plugin-manager: local Pi <<<\n")
        with rc.open("a", encoding="utf-8") as out:
            out.write(block)
    return rc


def real_pi():
    script = Path(__file__).resolve()
    for directory in os.get_exec_path():
        target = Path(directory) / "pi"
        if target.is_file() and os.access(target, os.X_OK) and target.resolve() != script:
            return target.absolute()
    raise FileNotFoundError("не найден исполняемый файл Pi вне обёртки")


def launch_pi(args):
    # Pi takes explicit -e paths for the process lifetime. Never write or approve project config.
    options = []
    if not (args and args[0] in PI_MANAGEMENT) and not {"-ne", "--no-extensions"}.intersection(args):
        for source, names in personal_choices().items():
            checkout = checkout_path(source)
            for name in names:
                try:
                    if not has_checkout(checkout):
                        raise ValueError("клон недоступен")
                    plugin = plugin_path(checkout, name)
                except (OSError, ValueError) as error:
                    print(f"pi-with-plugins: {inferred_alias(source)}/{name}: {error}", file=sys.stderr)
                    continue
                options += ["-e", str(plugin)]
    executable = real_pi()
    os.execv(str(executable), [str(executable), *options, *args])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    direct = Path(sys.argv[0]).name in {"pi", "pi-with-plugins"}
    if direct or sys.argv[1:2] == ["run"]:
        try:
            launch_pi(sys.argv[1:] if direct else sys.argv[2:])
        except (OSError, ValueError) as error:
            parser.exit(1, f"pi-with-plugins: {error}\n")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("sources", help="показать сохранённые Git-источники (JSON)")
    commands.add_parser("personal", help="показать личный выбор для текущего проекта (JSON)")
    commands.add_parser("install-launcher", help="подключить pi-with-plugins в ~/.local/bin")
    commands.add_parser("setup-local", help="подключить личные плагины к команде pi в bash/zsh")
    commands.add_parser("launcher-status", help="проверить настройку команды pi в текущей оболочке")
    commands.add_parser("run", help="запустить Pi с личным выбором для проекта")
    for action, help_text in (
        ("install", "скачать поставку при необходимости и подключить плагин здесь"),
        ("remove", "отключить плагин здесь, не удаляя общую копию"),
        ("personal-add", "подключить плагин лично для текущего проекта"),
        ("personal-remove", "удалить личное подключение для текущего проекта"),
        ("update", "обновить общую копию поставки для всех проектов"),
        ("source-add", "скачать и сохранить Git-источник под именем"),
        ("catalog", "показать доступные Pi-пакеты в источнике (JSON)"),
    ):
        command = commands.add_parser(action, help=help_text)
        command.add_argument("--source", default=os.environ.get("PI_PLUGINS_SOURCE"),
                             help="Git-адрес поставки (по умолчанию $PI_PLUGINS_SOURCE)")
        if action == "source-add":
            command.add_argument("alias", nargs="?", help="необязательное имя источника в меню /plugin")
        if action in {"install", "remove", "personal-add", "personal-remove"}:
            command.add_argument("plugin", help="имя каталога плагина в поставке или . для корневого пакета")
        if action in {"install", "remove"}:
            command.add_argument("--approve", action="store_true",
                                 help="передать Pi разрешение доверять проекту на эту команду")
    args = parser.parse_args()
    if args.command not in {"sources", "personal", "install-launcher", "setup-local", "launcher-status"}:
        args.source = normalize_source(args.source or "")
        if not valid_source(args.source):
            parser.error("укажите --source или PI_PLUGINS_SOURCE: адрес SSH/HTTPS либо абсолютный путь")
    if hasattr(args, "plugin") and not valid_plugin(args.plugin):
        parser.error("недопустимое имя плагина")
    if args.command == "source-add" and args.alias is not None and not PLUGIN_NAME.fullmatch(args.alias):
        parser.error("имя источника: строчные латинские буквы, цифры и дефисы")

    try:
        if args.command == "sources":
            print(json.dumps(sources()))
            return 0
        if args.command == "personal":
            print(json.dumps(personal_choices()))
            return 0
        if args.command == "install-launcher":
            print(install_launcher())
            return 0
        if args.command == "setup-local":
            print(setup_pi())
            return 0
        if args.command == "launcher-status":
            print(launcher_status())
            return 0
        source = args.source
        checkout = checkout_path(source)
        if args.command in {"personal-add", "personal-remove"}:
            save_personal_choice(source, args.plugin, enabled=args.command == "personal-add")
        elif args.command == "source-add":
            print(add_source(args.alias, source, checkout))
        elif args.command == "catalog":
            print(json.dumps(catalog(source, checkout)))
        elif args.command == "update":
            if not has_checkout(checkout):
                raise ValueError("Поставка ещё не скачана. Сначала добавьте источник или установите плагин.")
            run("git", "-C", str(checkout), "pull", "--ff-only")
        else:
            if args.command == "install":
                ensure_checkout(source, checkout)
                plugin = plugin_path(checkout, args.plugin)
            else:
                plugin = checkout / args.plugin
            options = ["--approve"] if args.approve else []
            run("pi", args.command, "-l", str(plugin), *options)
    except (OSError, ValueError) as error:
        parser.exit(1, f"pi-plugins: {error}\n")
    except subprocess.CalledProcessError as error:
        return error.returncode if error.returncode > 0 else 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
